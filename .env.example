# Binance — API key READ ONLY. JAMÁS withdrawal.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Google service account (ruta al JSON) + ID de la Sheet nativa
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
SHEET_ID=

# Ruta de la base SQLite de log AFIP
TRADES_DB_PATH=./data/trades.db

# La lectura de capturas usa Claude Max via Agent SDK (NO necesita API key).
# Requiere Claude Code instalado y logueado con Max en esta máquina.

# Puente de sync
SYNC_BRIDGE_TOKEN=     # secreto compartido bot<->compañero (generá uno random)
SYNC_BRIDGE_PORT=8765
SYNC_BRIDGE_URL=       # en el VPS: http://<tailscale-ip-de-tu-PC>:8765/sync

# Bot de Telegram
TELEGRAM_BOT_TOKEN=    # de @BotFather
TELEGRAM_CHAT_ID=      # tu chat id (te lo dice @userinfobot)

# --- Alertas de spread a Telegram ---
SPREAD_ALERT_CROSS_PCT=0.2
SPREAD_ALERT_INTRA_PCT=1.0
SPREAD_ALERT_COSTO_PCT=1.5
SPREAD_ALERT_HYSTERESIS_PCT=0.1
SPREAD_ALERT_STATE_PATH=./data/spread_alert_state.json
SPREAD_ALERT_CEXP2P_PCT=1.0
MAX_QUOTE_AGE_MIN=30

# --- Piso de alertas: nada por debajo de este neto llega a Telegram ---
SPREAD_ALERT_MIN_PCT=0.5

# Bybit — API key READ ONLY (opcional, para sincronizar tus órdenes P2P)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Tus apodos en los libros P2P, separados por coma. Se excluyen del libro para
# que el vigilante de avisos no se mida contra tu propio aviso.
MIS_NICKS_P2P=

# Marca que aparece en la placa de cotización al cliente
BRAND_NAME=MI CAMBIO

# Si corrés el dashboard en un servidor (VPS) y cargás ops desde tu PC:
VPS_API_URL=           # ej. http://<ip-privada-de-tu-servidor>:8002
DASHBOARD_URL=         # link que el bot te manda para abrir el tablero
SYNC_AGENT_TOKEN=      # secreto del agente de la PC (generá uno random)

# Lectura de capturas con un modelo de visión alternativo (opcional)
NVIDIA_API_KEY=
